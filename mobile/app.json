{
  "expo": {
    "name": "Belific",
    "slug": "belific",
    "version": "2.43.0",
    "scheme": "belific",
    "orientation": "portrait",
    "icon": "./assets/belificappicon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": false,
    "splash": {
      "image": "./assets/belificappicon.png",
      "resizeMode": "contain",
      "backgroundColor": "#F0EEE8"
    },
    "assetBundlePatterns": [
      "assets/sounds/*",
      "assets/**/*"
    ],
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.najeca.belific",
      "buildNumber": "1",
      "deploymentTarget": "16.4",
      "usesAppleSignIn": true,
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "UNNotificationDefaultSoundName": "notification.wav",
        "NSCalendarsUsageDescription": "Belific shows the events from your iPhone calendars next to your tasks in its Calendar tab. It only reads them: it never changes, copies or uploads them.",
        "NSCalendarsFullAccessUsageDescription": "Belific shows the events from your iPhone calendars next to your tasks in its Calendar tab. It only reads them: it never changes, copies or uploads them."
      }
    },
    "plugins": [
      "expo-font",
      "expo-router",
      "expo-apple-authentication",
      [
        "expo-notifications",
        {
          "icon": "./assets/belificappicon.png",
          "color": "#5C7A6B",
          "sounds": [
            "./assets/sounds/notification.wav"
          ]
        }
      ]
    ],
    "extra": {
      "router": {},
      "eas": {
        "projectId": "90588798-2a74-4eba-91b6-b7127c3bc3dd"
      }
    },
    "owner": "jetmakes",
    "android": {
      "package": "com.belific.app"
    },
    "web": {
      "bundler": "metro",
      "output": "single"
    }
  }
}
