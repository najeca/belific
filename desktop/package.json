{
  "name": "belific-desktop",
  "version": "0.1.0",
  "private": true,
  "description": "Belific Windows desktop shell (Electron around the Expo web export)",
  "main": "main.js",
  "scripts": {
    "desktop": "node scripts/build-web.js && electron .",
    "desktop:dev": "electron . --dev",
    "test": "node --test \"test/*.test.js\"",
    "test:real:cp6": "electron test/real/cp6.js",
    "dist": "node scripts/dist.js",
    "test:real:cp7": "node test/real/run-cp7.js",
    "test:real:cp8b": "node test/real/run-cp8b.js",
    "test:real:cp8c": "electron test/real/cp8c.js",
    "test:real:cp8d": "electron test/real/cp8d.js",
    "test:real:cp8e": "electron test/real/cp8e.js",
    "test:real:cp8f": "node test/real/run-cp8f.js",
    "test:real:cp7:installer": "node test/real/run-cp7.js --installer"
  },
  "devDependencies": {
    "electron": "44.5.1",
    "electron-builder": "26.15.3"
  },
  "build": {
    "appId": "com.najeca.belific.desktop",
    "productName": "Belific",
    "copyright": "Belific",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "preload.js",
      "src/**/*",
      "assets/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "../mobile/dist",
        "to": "web"
      }
    ],
    "asar": true,
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "assets/icon.png",
      "artifactName": "Belific-Setup-${version}.exe"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "allowElevation": false,
      "deleteAppDataOnUninstall": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Belific"
    },
    "protocols": [
      {
        "name": "Belific sign in",
        "schemes": [
          "belific"
        ]
      }
    ],
    "publish": null
  },
  "author": "Belific"
}
